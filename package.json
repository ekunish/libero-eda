{
  "name": "libero-eda",
  "version": "0.1.5",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5602",
    "build": "next build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && eslint . --max-warnings=0",
    "architecture": "steiger ./src --fail-on-warnings",
    "check": "biome check . && eslint . --max-warnings=0 && tsc --noEmit && pnpm architecture",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tanstack/react-query": "5.101.4",
    "apache-arrow": "21.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.2",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/nextjs-vite": "10.5.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "daisyui": "5.7.16",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.26",
    "steiger": "0.6.0",
    "storybook": "10.5.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
